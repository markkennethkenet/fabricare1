# Copy to .env and set your MySQL credentials
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=fabricare

# Hosted MySQL: use the provider's CA certificate for verified TLS.
# On Vercel, set MYSQL_SSL_CA_PEM to the full certificate, including newlines.
# Locally, MYSQL_SSL_CA can point to the downloaded CA certificate file.
MYSQL_SSL_CA=
